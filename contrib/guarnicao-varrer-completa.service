# Varredura completa da semana. Quem começa é o `guarnicao semanal`
# (guarnicao-semanal.timer): sozinho com o PC parado e na tomada, ou quando
# você clica em "Varrer agora" no aviso.
#
# Rodar agora:   systemctl --user start guarnicao-varrer-completa
# Parar:         systemctl --user stop guarnicao-varrer-completa

[Unit]
Description=Guarnição: varredura completa da semana

[Service]
Type=oneshot
WorkingDirectory=%h/guarnicao
# Sem --isolar: avisa e quem decide trancar é você, no launcher.
# 4 processos: cada um carrega as regras (~170 MB); com um por núcleo, a
# rápida chegou a 2,8 GB. Em segundo plano, a pressa não vale essa memória.
ExecStart=%h/guarnicao/.venv/bin/python -m guarnicao varrer --completa --agendada --processos 4
Environment=PYTHONUNBUFFERED=1
# Tarefa de fundo: cede CPU e disco a qualquer coisa que você estiver fazendo.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
# Memória: em 08/11/2026 a completa somou ~2 GB e o kernel, sem memória, fechou
# o jogo aberto. Passando de MemoryHigh ela é freada (o cache de disco dela é o
# primeiro a sair); MemoryMax é o teto. Se mesmo assim faltar memória no PC,
# o OOMScoreAdjust faz o kernel encerrar a varredura antes de qualquer programa seu.
MemoryHigh=1536M
MemoryMax=2560M
MemorySwapMax=512M
OOMScoreAdjust=1000
