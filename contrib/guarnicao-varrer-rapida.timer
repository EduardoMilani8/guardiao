# Timer de usuário do systemd: varredura rápida todo dia.
#
# Instalado por contrib/instalar-servicos.sh (junto com o guarnicao-semanal.timer,
# que cuida da completa da semana).
#
# Próxima execução:   systemctl --user list-timers 'guarnicao-*'
# Rodar agora:        systemctl --user start guarnicao-varrer-rapida
# Ver o que fez:      python -m guarnicao historico   (ou journalctl --user -u guarnicao-varrer-rapida)
# Desinstalar:        systemctl --user disable --now guarnicao-varrer-rapida.timer

[Unit]
Description=Guarnição: varredura rápida todo dia

[Timer]
OnCalendar=*-*-* 12:30
# Desligado na hora marcada? Roda assim que ligar.
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
