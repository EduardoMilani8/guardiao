# Atualiza as bases de detecção. Chamado pelo guardiao-atualizar.timer.
# A instalação está no guardiao-atualizar.timer.

[Unit]
Description=Guardião: atualizar bases de detecção
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/guardiao
ExecStart=%h/guardiao/.venv/bin/python -m guardiao atualizar
Environment=PYTHONUNBUFFERED=1
# Atualizar é tarefa de fundo: não deve disputar CPU nem disco com você.
Nice=10
IOSchedulingClass=idle
