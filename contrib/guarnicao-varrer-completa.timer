# Timer de usuário do systemd: varredura completa todo domingo.
#
# Instalar (as duas agendadas de uma vez):
#   mkdir -p ~/.config/systemd/user
#   cp contrib/guarnicao-varrer-*.service contrib/guarnicao-varrer-*.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now guarnicao-varrer-rapida.timer guarnicao-varrer-completa.timer
#
# Próxima execução:   systemctl --user list-timers 'guarnicao-varrer-*'
# Rodar agora:        systemctl --user start guarnicao-varrer-completa
# Ver o que fez:      python -m guarnicao historico   (ou journalctl --user -u guarnicao-varrer-completa)
# Desinstalar:        systemctl --user disable --now guarnicao-varrer-completa.timer

[Unit]
Description=Guarnição: varredura completa todo domingo

[Timer]
OnCalendar=Sun 13:00
# Desligado na hora marcada? Roda assim que ligar.
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
