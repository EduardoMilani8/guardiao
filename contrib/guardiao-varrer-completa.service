# Varredura completa agendada. Chamado pelo guardiao-varrer-completa.timer.
# A instalação está no guardiao-varrer-completa.timer.

[Unit]
Description=Guardião: varredura completa agendada
# O disco inteiro na bateria gasta carga à toa: espera o carregador.
ConditionACPower=true

[Service]
Type=oneshot
WorkingDirectory=%h/guardiao
# Sem --isolar: avisa e quem decide trancar é você, no launcher.
ExecStart=%h/guardiao/.venv/bin/python -m guardiao varrer --completa --agendada
Environment=PYTHONUNBUFFERED=1
# Tarefa de fundo: cede CPU e disco a qualquer coisa que você estiver fazendo.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
