# Timer de usuário do systemd: varredura rápida todo dia.
#
# Instalar (as duas agendadas de uma vez):
#   mkdir -p ~/.config/systemd/user
#   cp contrib/guardiao-varrer-*.service contrib/guardiao-varrer-*.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now guardiao-varrer-rapida.timer guardiao-varrer-completa.timer
#
# Próxima execução:   systemctl --user list-timers 'guardiao-varrer-*'
# Rodar agora:        systemctl --user start guardiao-varrer-rapida
# Ver o que fez:      python -m guardiao historico   (ou journalctl --user -u guardiao-varrer-rapida)
# Desinstalar:        systemctl --user disable --now guardiao-varrer-rapida.timer

[Unit]
Description=Guardião: varredura rápida todo dia

[Timer]
OnCalendar=*-*-* 12:30
# Desligado na hora marcada? Roda assim que ligar.
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
