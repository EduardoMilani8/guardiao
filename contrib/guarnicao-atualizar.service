# Atualiza as bases de detecção. Chamado pelo guarnicao-atualizar.timer.
# A instalação está no guarnicao-atualizar.timer.

[Unit]
Description=Guarnição: atualizar bases de detecção
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/guarnicao
ExecStart=%h/guarnicao/.venv/bin/python -m guarnicao atualizar
Environment=PYTHONUNBUFFERED=1
# Atualizar é tarefa de fundo: não deve disputar CPU nem disco com você.
Nice=10
IOSchedulingClass=idle
